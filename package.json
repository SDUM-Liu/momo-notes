{
  "name": "momo-notes",
  "version": "0.8.14",
  "description": "A desktop and mobile companion for daily notes and checklists",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run build:tcp-probe && vite build && electron .",
    "build:tcp-probe": "node build/tcp-probe.cjs",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:mac:preview": "npm run build && electron-builder --mac dmg zip --config build/unsigned-mac.cjs --publish never",
    "mobile:sync": "npm run build && cap sync"
  },
  "keywords": [],
  "author": "SDUM-Liu",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.4",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/inappbrowser": "^4.1.0",
    "@capacitor/ios": "^8.6.2",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "jsqr": "^1.4.0",
    "lucide-static": "^1.75.0",
    "qrcode": "^1.5.4",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SDUM-Liu/momo-notes.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
